NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://aim_admin:aim_local_dev_change_me@127.0.0.1:27017/fundsprojects_aim?authSource=admin
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_TTL_DAYS=30
ACCESS_COOKIE_NAME=aim_access_token
REFRESH_COOKIE_NAME=aim_refresh_token
ACTIVATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=FundsProjects AIM <no-reply@fundsprojects.local>
EMAIL_DELIVERY_MODE=smtp
BOOTSTRAP_ADMIN_FULL_NAME=FundsProjects Admin
BOOTSTRAP_ADMIN_EMAIL=admin@fundsprojects.local
BOOTSTRAP_ADMIN_MOBILE=+919999999999
BOOTSTRAP_ADMIN_DESIGNATION=Administrator
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
REQUEST_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Phase 7 private local storage (production swaps provider)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage/private
MAX_UPLOAD_MB=10
